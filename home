<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>BOLD AFTER DARK</title>

  <style>
    * {
      box-sizing: border-box;
    }

    :root {
      --red: #e00000;
      --red-dark: #a80000;
      --bg: #050505;
      --card: #111111;
      --card-2: #181818;
      --border: #303030;
      --text: #ffffff;
      --muted: #999999;
      --green: #20d96b;
    }

    html {
      min-height: 100%;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(
          circle at 50% 0%,
          #350000 0%,
          #100000 22%,
          #050505 58%,
          #000000 100%
        );
      color: var(--text);
      font-family: Arial, Helvetica, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 24px 16px;
    }

    .container {
      width: 100%;
      max-width: 520px;
      text-align: center;
    }

    .brand {
      font-size: clamp(30px, 8vw, 48px);
      line-height: 1;
      font-weight: 900;
      letter-spacing: 4px;
      text-transform: uppercase;
    }

    .brand .red {
      color: var(--red);
    }

    .subtitle {
      margin-top: 12px;
      color: #ffffff;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 4px;
      text-transform: uppercase;
    }

    .divider {
      width: 70px;
      height: 3px;
      margin: 22px auto 28px;
      background: linear-gradient(
        to right,
        #ffffff 0%,
        #ffffff 33%,
        var(--red) 33%,
        var(--red) 66%,
        #ffffff 66%,
        #ffffff 100%
      );
      border-radius: 10px;
    }

    .menu {
      display: flex;
      flex-direction: column;
      gap: 13px;
    }

    .menu-button {
      width: 100%;
      min-height: 72px;
      padding: 16px 20px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: rgba(17, 17, 17, 0.96);
      color: #ffffff;
      cursor: pointer;
      text-align: left;
      display: flex;
      align-items: center;
      gap: 16px;
      transition:
        transform 0.15s ease,
        border-color 0.15s ease,
        background 0.15s ease;
    }

    .menu-button:hover {
      border-color: var(--red);
      background: #171717;
      transform: translateY(-2px);
    }

    .menu-button:active {
      transform: scale(0.98);
    }

    .icon {
      width: 44px;
      height: 44px;
      flex: 0 0 44px;
      border-radius: 11px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 21px;
      font-weight: 900;
      background: #ffffff;
      color: #000000;
    }

    .menu-button.primary .icon {
      background: var(--red);
      color: #ffffff;
    }

    .menu-text {
      flex: 1;
      min-width: 0;
    }

    .menu-title {
      font-size: 15px;
      font-weight: 900;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .menu-description {
      margin-top: 5px;
      color: #888888;
      font-size: 11px;
      line-height: 1.4;
    }

    .arrow {
      color: #777777;
      font-size: 22px;
      font-weight: 700;
    }

    .footer {
      margin-top: 28px;
      color: #555555;
      font-size: 9px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    /* SHARE MODAL */

    .modal {
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(0, 0, 0, 0.82);
      backdrop-filter: blur(5px);
    }

    .modal.show {
      display: flex;
    }

    .modal-card {
      width: 100%;
      max-width: 420px;
      background: #111111;
      border: 1px solid #333333;
      border-radius: 18px;
      padding: 22px;
      box-shadow: 0 25px 80px rgba(0, 0, 0, 0.7);
      animation: modalIn 0.18s ease-out;
    }

    @keyframes modalIn {
      from {
        opacity: 0;
        transform: translateY(12px) scale(0.98);
      }

      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
    }

    .modal-title {
      font-size: 17px;
      font-weight: 900;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .close-button {
      width: 36px;
      height: 36px;
      border: 1px solid #333333;
      border-radius: 9px;
      background: #181818;
      color: #ffffff;
      font-size: 18px;
      cursor: pointer;
    }

    .close-button:hover {
      border-color: var(--red);
      background: #220000;
    }

    .share-link-box {
      display: flex;
      gap: 8px;
      margin-bottom: 16px;
    }

    .share-link {
      flex: 1;
      min-width: 0;
      min-height: 44px;
      padding: 12px;
      border: 1px solid #333333;
      border-radius: 9px;
      background: #080808;
      color: #cccccc;
      font-size: 11px;
      outline: none;
    }

    .copy-small {
      min-width: 75px;
      border: none;
      border-radius: 9px;
      background: #ffffff;
      color: #000000;
      font-size: 11px;
      font-weight: 900;
      cursor: pointer;
    }

    .copy-small:hover {
      background: #eeeeee;
    }

    .share-options {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .share-button {
      min-height: 58px;
      border: 1px solid #333333;
      border-radius: 11px;
      background: #181818;
      color: #ffffff;
      cursor: pointer;
      font-size: 12px;
      font-weight: 900;
    }

    .share-button:hover {
      border-color: var(--red);
      background: #202020;
    }

    .share-icon {
      display: block;
      margin-bottom: 4px;
      font-size: 19px;
    }

    .share-note {
      margin-top: 15px;
      color: #666666;
      font-size: 10px;
      line-height: 1.5;
      text-align: center;
    }

    .toast {
      position: fixed;
      left: 50%;
      bottom: 25px;
      z-index: 2000;
      transform: translateX(-50%) translateY(20px);
      min-width: 220px;
      max-width: calc(100% - 32px);
      padding: 12px 16px;
      border: 1px solid #444444;
      border-radius: 10px;
      background: #151515;
      color: #ffffff;
      font-size: 12px;
      font-weight: 700;
      text-align: center;
      opacity: 0;
      pointer-events: none;
      transition: all 0.2s ease;
    }

    .toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    @media (max-width: 480px) {
      body {
        padding: 20px 13px;
      }

      .brand {
        letter-spacing: 3px;
      }

      .menu-button {
        min-height: 68px;
      }

      .share-options {
        grid-template-columns: 1fr 1fr;
      }
    }
  </style>
</head>

<body>

  <main class="container">

    <div class="brand">
      BOLD <span class="red">AFTER DARK</span>
    </div>

    <div class="subtitle">
      Registration • Scanner • Admin
    </div>

    <div class="divider"></div>

    <div class="menu">

      <!-- REGISTRATION -->
      <button
        class="menu-button primary"
        type="button"
        id="registrationButton"
      >
        <div class="icon">↗</div>

        <div class="menu-text">
          <div class="menu-title">
            Registration Form
          </div>

          <div class="menu-description">
            Daftar dan bagikan link registration
          </div>
        </div>

        <div class="arrow">›</div>
      </button>

      <!-- SCANNER -->
      <button
        class="menu-button"
        type="button"
        id="scannerButton"
      >
        <div class="icon">▣</div>

        <div class="menu-text">
          <div class="menu-title">
            QR Scanner
          </div>

          <div class="menu-description">
            Scan QR ticket untuk check-in
          </div>
        </div>

        <div class="arrow">›</div>
      </button>

      <!-- ADMIN -->
      <button
        class="menu-button"
        type="button"
        id="adminButton"
      >
        <div class="icon">⚙</div>

        <div class="menu-text">
          <div class="menu-title">
            Admin
          </div>

          <div class="menu-description">
            Kelola data dan akses laporan
          </div>
        </div>

        <div class="arrow">›</div>
      </button>

    </div>

    <div class="footer">
      BOLD AFTER DARK • OFFICIAL EVENT SYSTEM
    </div>

  </main>


  <!-- SHARE MODAL -->

  <div
    id="shareModal"
    class="modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="shareModalTitle"
  >

    <div class="modal-card">

      <div class="modal-header">

        <div
          id="shareModalTitle"
          class="modal-title"
        >
          Share Registration
        </div>

        <button
          id="closeModalButton"
          class="close-button"
          type="button"
          aria-label="Tutup"
        >
          ×
        </button>

      </div>


      <div class="share-link-box">

        <input
          id="registrationLink"
          class="share-link"
          type="text"
          readonly
          value=""
        >

        <button
          id="copyButton"
          class="copy-small"
          type="button"
        >
          COPY
        </button>

      </div>


      <div class="share-options">

        <!-- WHATSAPP -->
        <button
          id="whatsappShareButton"
          class="share-button"
          type="button"
        >
          <span class="share-icon">☏</span>
          WhatsApp
        </button>

        <!-- INSTAGRAM -->
        <button
          id="instagramShareButton"
          class="share-button"
          type="button"
        >
          <span class="share-icon">◎</span>
          Instagram
        </button>

        <!-- FACEBOOK -->
        <button
          id="facebookShareButton"
          class="share-button"
          type="button"
        >
          <span class="share-icon">f</span>
          Facebook
        </button>

        <!-- COPY LINK -->
        <button
          id="copyLinkButton"
          class="share-button"
          type="button"
        >
          <span class="share-icon">🔗</span>
          Copy Link
        </button>

      </div>


      <div class="share-note">
        Instagram tidak menyediakan tombol share URL langsung dari browser.
        Gunakan Copy Link lalu bagikan melalui Instagram.
      </div>

    </div>

  </div>


  <div
    id="toast"
    class="toast"
  ></div>


  <script>
    "use strict";

    /*
      ==========================================================
      BOLD AFTER DARK — HOME
      ==========================================================
    */

    const REGISTRATION_URL =
      "https://purbalinggabmtc-cmyk.github.io/bold-after-dark-scanner/registration/";

    const SCANNER_URL =
      "index.html";

    const ADMIN_URL =
      "admin.html";


    const registrationButton =
      document.getElementById(
        "registrationButton"
      );

    const scannerButton =
      document.getElementById(
        "scannerButton"
      );

    const adminButton =
      document.getElementById(
        "adminButton"
      );

    const shareModal =
      document.getElementById(
        "shareModal"
      );

    const closeModalButton =
      document.getElementById(
        "closeModalButton"
      );

    const registrationLink =
      document.getElementById(
        "registrationLink"
      );

    const copyButton =
      document.getElementById(
        "copyButton"
      );

    const copyLinkButton =
      document.getElementById(
        "copyLinkButton"
      );

    const whatsappShareButton =
      document.getElementById(
        "whatsappShareButton"
      );

    const instagramShareButton =
      document.getElementById(
        "instagramShareButton"
      );

    const facebookShareButton =
      document.getElementById(
        "facebookShareButton"
      );

    const toast =
      document.getElementById(
        "toast"
      );


    let toastTimer = null;


    function showToast(message) {
      clearTimeout(toastTimer);

      toast.textContent =
        message || "";

      toast.classList.add(
        "show"
      );

      toastTimer =
        setTimeout(
          function() {
            toast.classList.remove(
              "show"
            );
          },
          2200
        );
    }


    function openRegistration() {
      window.location.href =
        REGISTRATION_URL;
    }


    function openScanner() {
      window.location.href =
        SCANNER_URL;
    }


    function openAdmin() {
      window.location.href =
        ADMIN_URL;
    }


    function openShareModal() {
      registrationLink.value =
        REGISTRATION_URL;

      shareModal.classList.add(
        "show"
      );

      setTimeout(
        function() {
          closeModalButton.focus();
        },
        50
      );
    }


    function closeShareModal() {
      shareModal.classList.remove(
        "show"
      );
    }


    async function copyRegistrationLink() {
      const link =
        REGISTRATION_URL;

      try {
        await navigator.clipboard.writeText(
          link
        );

        showToast(
          "Link registration berhasil disalin."
        );

      } catch (error) {

        registrationLink.focus();
        registrationLink.select();

        try {
          document.execCommand(
            "copy"
          );

          showToast(
            "Link registration berhasil disalin."
          );

        } catch {
          showToast(
            "Silakan copy link secara manual."
          );
        }
      }
    }


    function shareWhatsApp() {
      const message =
        "BOLD AFTER DARK — Registration\n\n" +
        "Daftar melalui link berikut:\n" +
        REGISTRATION_URL;

      const url =
        "https://wa.me/?text=" +
        encodeURIComponent(
          message
        );

      window.open(
        url,
        "_blank",
        "noopener,noreferrer"
      );
    }


    function shareFacebook() {
      const url =
        "https://www.facebook.com/sharer/sharer.php?u=" +
        encodeURIComponent(
          REGISTRATION_URL
        );

      window.open(
        url,
        "_blank",
        "noopener,noreferrer"
      );
    }


    async function shareInstagram() {

      await copyRegistrationLink();

      setTimeout(
        function() {
          window.open(
            "https://www.instagram.com/",
            "_blank",
            "noopener,noreferrer"
          );
        },
        300
      );
    }


    registrationButton.addEventListener(
      "click",
      openShareModal
    );


    scannerButton.addEventListener(
      "click",
      openScanner
    );


    adminButton.addEventListener(
      "click",
      openAdmin
    );


    closeModalButton.addEventListener(
      "click",
      closeShareModal
    );


    copyButton.addEventListener(
      "click",
      copyRegistrationLink
    );


    copyLinkButton.addEventListener(
      "click",
      copyRegistrationLink
    );


    whatsappShareButton.addEventListener(
      "click",
      shareWhatsApp
    );


    instagramShareButton.addEventListener(
      "click",
      shareInstagram
    );


    facebookShareButton.addEventListener(
      "click",
      shareFacebook
    );


    shareModal.addEventListener(
      "click",
      function(event) {
        if (
          event.target ===
          shareModal
        ) {
          closeShareModal();
        }
      }
    );


    document.addEventListener(
      "keydown",
      function(event) {
        if (
          event.key === "Escape" &&
          shareModal.classList.contains(
            "show"
          )
        ) {
          closeShareModal();
        }
      }
    );

  </script>

</body>
</html>
